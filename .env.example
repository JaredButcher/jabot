# Deployment settings for compose.yaml. Copy to .env next to compose.yaml and fill in.

# Public host name. /tell prints https://$DOMAIN$BASE_PATH/tell.
DOMAIN=example.com
# Optional LAN host name, if the front proxy also serves the bot under one.
LAN_HOST=

# Port the bot listens on in the container, and publishes on the host.
HTTP_PORT=8080
# Host address to publish on: 127.0.0.1 when the front proxy runs on this machine.
HTTP_PUBLISH=127.0.0.1
# Prefix of every bot URL; the front proxy forwards $BASE_PATH/* here unchanged.
BASE_PATH=/jabot
# Comma-separated IPs/CIDR ranges allowed to set X-Forwarded-For. A proxy on this machine
# reaching the published port connects from 172.30.0.1. Empty ignores the header.
TRUSTED_PROXIES=

RUST_LOG=info

# Daily database backups (README, "Backups"). Empty RESTIC_REPOSITORY disables them, e.g.
# s3:https://s3.us-west-004.backblazeb2.com/jabot-backups/jabot
RESTIC_REPOSITORY=
# Time of the daily backup, in UTC.
BACKUP_TIME_UTC=08:00
# Discord user id of the bot's admin, who is DMed when backups fail. Empty: only logged.
BOT_OWNER_ID=
